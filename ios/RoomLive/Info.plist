<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Room Live</string>
	<key>NSCameraUsageDescription</key>
	<string>Нужна камера для LiDAR-сканирования комнаты (ARKit mesh / RoomPlan)</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Нужен доступ к локальной сети для стрима скана на Room Live сервер. Разреши «Локальная сеть» для Room Live.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp.</string>
		<string>_ws._tcp.</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arkit</string>
		<string>metal</string>
	</array>
</dict>
</plist>
